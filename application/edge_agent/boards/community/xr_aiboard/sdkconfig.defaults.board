# xr_aiboard — ESP32-S3
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash: DIO 16MB @ 80MHz
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# PSRAM: Quad @ 80MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# Quad PSRAM cannot keep the stack accessible while cache is disabled for a flash
# transaction, and XIP-from-PSRAM requires Octal PSRAM on ESP32-S3.
# Force FreeRTOS task stacks into internal RAM so claw tasks tagged
# CLAW_TASK_STACK_PREFER_PSRAM fall back to internal memory.
# (See m5stack_cores3 / waveshare_esp32_s3_geek for the same constraint.)
CONFIG_SPIRAM_XIP_FROM_PSRAM=n
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=n
CONFIG_SPIRAM_RODATA=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
CONFIG_MDNS_TASK_CREATE_FROM_INTERNAL=y

# USB: Serial JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
